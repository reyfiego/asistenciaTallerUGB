# Clave maestra del docente para acceder a /consola, /exif, /dossier y leer/purgar /api/telemetria.
# Genera una propia (ej. `openssl rand -hex 24`) y NUNCA la subas al repositorio.
# Copia este archivo como .env.local para desarrollo local y define estas variables en Render.
INSTRUCTOR_ACCESS_KEY=cambia-esta-clave-por-una-propia

# Secreto opcional para firmar cookies HMAC-SHA256 (mínimo 32 caracteres recomendados).
# Si se omite, se deriva internamente de INSTRUCTOR_ACCESS_KEY.
SESSION_SECRET=cambia-este-secreto-por-uno-propio-de-32-o-mas-caracteres
